# Supabase (get values from: npx supabase status)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon key from supabase status>
SUPABASE_SERVICE_ROLE_KEY=<service_role key from supabase status>

# Tika server (running via docker compose up -d tika)
TIKA_URL=http://localhost:9998

# Optional: GitHub PAT for higher rate limits (60 → 5000 req/hour)
GITHUB_TOKEN_DEFAULT=

# API server port
PORT=3001

# Frontend (set for production deploys)
# VITE_API_URL=https://your-api.render.com
